{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.user_list'|trans }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .floating-btn {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            border: none;
            background: linear-gradient(135deg, #007bff, #0056b3);
            position: fixed;
            bottom: 20px;
            right: 20px;
            box-shadow: 0 4px 20px rgba(0, 123, 255, 0.3);
            z-index: 1000;
            transition: all 0.3s ease;
        }
        .table>:not(caption)>*>* {
            background-color: #dbeafe;
        }

        .floating-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 25px rgba(0, 123, 255, 0.4);
        }

        .floating-btn a {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 100%;
            height: 100%;
            text-decoration: none;
            color: white;
            font-size: 24px;
        }

        .floating-btn a:hover {
            color: white;
        }

        @media (max-width: 768px) {
            .floating-btn {
                width: 56px;
                height: 56px;
                bottom: 16px;
                right: 16px;
            }

            .table-responsive {
                font-size: 0.875rem;
            }

            .btn-sm {
                font-size: 0.75rem;
                padding: 0.25rem 0.5rem;
            }
        }

        @media (max-width: 576px) {
            .page-header {
                text-align: center;
                margin-bottom: 1rem;
            }

            .back-to-urls {
                text-align: center;
                margin-bottom: 1rem;
            }

            .table td {
                vertical-align: middle;
            }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="row mb-3 page-header">
        <div class="col-12 col-md-8">
            <h1 class="h3 mb-2 mb-md-0">{{ 'title.user_list'|trans }}</h1>
        </div>
        <div class="col-12 col-md-4 back-to-urls" style="display:flex;justify-content:end">
            <a href="{{ path('url_index') }}" class="btn btn-info btn-sm">
                <i class="bi bi-arrow-left"></i>
                <span class="d-none d-sm-inline">{{ 'action.urlsList'|trans }}</span>
                <span class="d-sm-none">{{ 'action.back'|trans }}</span>
            </a>
        </div>
    </div>

    {% if pagination is defined and pagination.items|length %}
        <div class="navigation text-center mb-3">
            {{ knp_pagination_render(pagination) }}
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                <tr>
                    <th class="d-none d-md-table-cell">{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'user.id') }}</th>
                    <th>{{ knp_pagination_sortable(pagination, 'label.email'|trans, 'user.email') }}</th>
                    <th class="d-none d-sm-table-cell">{{ knp_pagination_sortable(pagination, 'label.roles'|trans, 'users.roles') }}</th>
                    <th style="color: black">{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for user in pagination.items %}
                    <tr>
                        <td class="d-none d-md-table-cell">
                            <small class="text-muted">#{{ user.id }}</small>
                        </td>
                        <td>
                            <div class="d-flex flex-column">
                                <span class="fw-medium">{{ user.email }}</span>
                                <div class="d-md-none">
                                    <small class="text-muted">#{{ user.id }}</small>
                                </div>
                                <div class="d-sm-none mt-1">
                                    {% for role in user.roles %}
                                        <span class="badge bg-secondary me-1 mb-1" style="font-size:0.7rem;">{{ role }}</span>
                                    {% endfor %}
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-sm-table-cell">
                            {% for role in user.roles %}
                                <span class="badge bg-secondary me-1 mb-1">{{ role }}</span>
                            {% endfor %}
                        </td>
                        <td>
                            <div class="d-flex gap-1">
                                <a href="{{ path('app_user_admin_edit', {id: user.id}) }}"
                                   class="btn btn-outline-primary btn-sm"
                                   title="{{ 'action.edit'|trans }}">
                                    <i class="bi bi-pencil"></i>
                                    <span class="d-none d-lg-inline ms-1">{{ 'action.edit'|trans }}</span>
                                </a>
                                <a href="{{ path('app_user_admin_delete', {id: user.id}) }}"
                                   class="btn btn-outline-danger btn-sm"
                                   title="{{ 'action.delete'|trans }}">
                                    <i class="bi bi-trash"></i>
                                    <span class="d-none d-lg-inline ms-1">{{ 'action.delete'|trans }}</span>
                                </a>
                                <div class="d-sm-none">
                                    <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><span class="dropdown-header">{{ 'label.user_info'|trans }}</span></li>
                                        <li><span class="dropdown-item-text small">{{ 'label.id_short'|trans }}: #{{ user.id }}</span></li>
                                        <li><span class="dropdown-item-text small">{{ 'label.email'|trans }}: {{ user.email }}</span></li>
                                        {% if user.roles|length %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><span class="dropdown-header">{{ 'label.roles'|trans }}</span></li>
                                            {% for role in user.roles %}
                                                <li><span class="dropdown-item-text small">{{ role }}</span></li>
                                            {% endfor %}
                                        {% endif %}
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger"
                                               href="{{ path('app_user_admin_delete', {id: user.id}) }}">
                                                <i class="bi bi-trash me-2"></i>{{ 'action.delete'|trans }}
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="navigation text-center mt-3">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <div class="text-center py-5">
            <i class="bi bi-people display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">{{ 'message.empty_list'|trans }}</h3>
            <p class="text-muted">{{ 'message.no_users_yet'|trans }}</p>
        </div>
    {% endif %}

    <button class="floating-btn" title="{{ 'title.create'|trans }}">
        <a href="{{ path('url_create') }}">
            <i class="bi bi-plus"></i>
        </a>
    </button>
{% endblock %}