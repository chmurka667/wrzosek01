{% extends 'base.html.twig' %}

{% block title %}Log in and Shorten URL{% endblock %}

{% block body %}
    <form method="post" action="{{ path('app_login') }}">
        {% if error %}
            <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <div class="register-link">
            <a href="{{ path('app_register') }}">{{ 'title.register'|trans }}</a>
        </div>

        <h1 class="h3 mb-3 font-weight-normal">{{ 'title.Please_sign_in'|trans }}</h1>
        <label for="inputEmail">{{ 'label.email'|trans }}</label>
        <input type="email" value="{{ last_username }}" name="email" id="inputEmail" class="form-control" autocomplete="email" required autofocus>

        <label for="inputPassword">{{ 'label.password'|trans }}</label>
        <input type="password" name="password" id="inputPassword" class="form-control" autocomplete="current-password" required>

        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

        <button class="btn btn-lg btn-primary" style="margin-top:1svh;" type="submit">{{ 'label.log_in'|trans }}</button>
    </form>
    <div class="d-flex justify-content-center" style="display: inline">
        {% if not is_granted('ROLE_USER') %}
            <button class="btn btn-lg btn-primary w-100" style="max-width: 19rem; margin-bottom:2svh; margin-top:4svh; display: inline" type="submit">
                <a href="{{ url('url_create') }}" style="color: floralwhite; text-decoration: none">
                    {{ 'action.create_withoout_registering'|trans }}
                </a>
            </button>

        {% endif %}
    </div>

    <div class="d-flex justify-content-center">
        <a href="{{ path('url_index') }}" class="btn btn-lg btn-primary w-100" style="max-width: 19rem;">
            {{ 'title.back_to_index'|trans }}
        </a>
    </div>
{% endblock %}
