{% extends 'base.html.twig' %}

{% block title %}
    {{ 'title.url_list'|trans }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .floating-btn { margin-bottom: 30px; width: 60px; height: 60px; border-radius: 50%; border: none; background: linear-gradient(135deg, #007bff, #0056b3); position: fixed; bottom: 20px; right: 20px; box-shadow: 0 4px 20px rgba(0, 123, 255, 0.3); z-index: 1000; transition: all 0.3s ease; }
        .floating-btn:hover { transform: translateY(-2px); box-shadow: 0 6px 25px rgba(0, 123, 255, 0.4); }
        .floating-btn a { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; text-decoration: none; color: white; font-size: 24px; }
        .floating-btn a:hover { color: white; }

        @media (max-width: 1246px) {
            .page-header { text-align: center; margin-bottom: 1rem; }
            .admin-controls { text-align: center; margin-bottom: 1rem; }
            .table td { vertical-align: middle; }
            .url-cell { word-break: break-all; max-width: 150px; }
        }
    </style>
{% endblock %}

{% block body %}
    <div class="row mb-3 page-header">
        <div class="col-12 col-md-8">
            <h1 class="h3 mb-2 mb-md-0">{{ 'title.url_list'|trans }}</h1>
        </div>
        <div class="col-12 col-md-4 admin-controls" style="display: flex; justify-content: flex-end;">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('app_user_list') }}" class="btn btn-success btn-sm">
                    <i class="bi bi-emoji-sunglasses-fill"></i>
                    {{ 'action.userList'|trans }}
                </a>
            {% endif %}
        </div>
    </div>

    {% if pagination is defined and pagination.items|length %}
        <div class="navigation text-center mb-3" style="scale: 0.87;">
            {{ knp_pagination_render(pagination) }}
        </div>

        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                <tr>
                    <th class="d-none d-md-table-cell" style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.id'|trans, 'url.id') }}</th>
                    <th class="d-none d-lg-table-cell" style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.created_at'|trans, 'url.createdAt') }}</th>
                    <th style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.original_url'|trans, 'url.originalUrl') }}</th>
                    <th class="d-none d-sm-table-cell" style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.shortened_url'|trans, 'url.shortenedUrl') }}</th>
                    {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                        <th class="d-none d-lg-table-cell" style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.email'|trans, 'url.email') }}</th>
                    {% endif %}
                    <th class="d-none d-md-table-cell" style="background-color: white;">{{ knp_pagination_sortable(pagination, 'label.clicks'|trans, 'url.clicks') }}</th>
                    <th class="d-none d-sm-table-cell" style="background-color: white; color: #333333">{{ 'label.tag'|trans }}</th>
                    <th style="background-color: white; color: #333333">{{ 'label.actions'|trans }}</th>
                </tr>
                </thead>
                <tbody>
                {% for url in pagination.items %}
                    <tr>
                        <td class="d-none d-md-table-cell">
                            <small class="text-muted">#{{ url.id }}</small>
                        </td>
                        <td class="d-none d-lg-table-cell">
                            <small>{{ url.createdAt|format_date('short') }}</small>
                        </td>
                        <td class="url-cell">
                            <div class="d-flex flex-column">
                                <span class="fw-medium">{{ url.originalUrl|length > 40 ? url.originalUrl|slice(0, 40) ~ '...' : url.originalUrl }}</span>
                                <div class="d-md-none">
                                    <small class="text-muted">#{{ url.id }} • {{ url.createdAt|format_date('short') }}</small>
                                    {% if url.clicks %}
                                        <br><small class="badge bg-info">{{ 'label.clicks_mobile'|trans({'%count%': url.clicks}) }}</small>
                                    {% endif %}
                                </div>
                            </div>
                        </td>
                        <td class="d-none d-sm-table-cell url-cell">
                            <code class="small">{{ url.shortenedUrl }}</code>
                        </td>
                        {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                            <td class="d-none d-lg-table-cell">
                                <small>{{ url.email }}</small>
                            </td>
                        {% endif %}
                        <td class="d-none d-md-table-cell">
                            <span class="badge bg-primary">{{ url.clicks }}</span>
                        </td>
                        <td class="d-none d-sm-table-cell">
                            {% if url.tags is defined and url.tags|length %}
                                <div class="tag-container">
                                    {% for tag in url.tags %}
                                        <a class="badge bg-outline-primary text-decoration-none"
                                           style="color: #333333"
                                           href="{{ url('url_index', {'tagId': tag.id}) }}"
                                           title="{{ tag.title }}">
                                            {{ tag.title }}
                                        </a>
                                    {% endfor %}
                                </div>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td>
                            <div class="d-flex gap-1" style="justify-content: end;">
                                <a href="{{ url('url_show', {id: url.id}) }}"
                                   class="btn btn-outline-primary btn-sm"
                                   title="{{ 'action.show'|trans }}">
                                    <i class="bi bi-eye"></i>
                                    <span class="d-none d-lg-inline ms-1">{{ 'action.show'|trans }}</span>
                                </a>
                                <div class="d-sm-none">
                                    <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle"
                                            data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li><span class="dropdown-header">{{ 'label.quick_info'|trans }}</span></li>
                                        <li><span class="dropdown-item-text small">
                                            {{ 'label.short'|trans }}:
                                            <a href="{{ url.shortenedUrl }}" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-primary">
                                                {{ url.shortenedUrl }}
                                                <i class="bi bi-box-arrow-up-right" style="font-size: 0.7rem;"></i>
                                            </a>
                                        </span></li>
                                        {% if url.tags is defined and url.tags|length %}
                                            <li><hr class="dropdown-divider"></li>
                                            <li><span class="dropdown-header">{{ 'label.tags'|trans }}</span></li>
                                            {% for tag in url.tags %}
                                                <li>
                                                    <a class="dropdown-item small" href="{{ url('url_index', {'tagId': tag.id}) }}">
                                                        {{ tag.title }}
                                                    </a>
                                                </li>
                                            {% endfor %}
                                        {% endif %}
                                    </ul>
                                </div>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="navigation text-center mt-3" style="scale: 0.87;">
            {{ knp_pagination_render(pagination) }}
        </div>

    {% else %}
        <div class="text-center py-5">
            <i class="bi bi-link-45deg display-1 text-muted"></i>
            <h3 class="mt-3 text-muted">{{ 'message.empty_list'|trans }}</h3>
            <p class="text-muted">{{ 'message.no_urls_yet'|trans }}</p>
        </div>
    {% endif %}

    <button class="floating-btn" title="{{ 'title.create'|trans }}">
        <a href="{{ path('url_create') }}">
            <i class="bi bi-plus"></i>
        </a>
    </button>
{% endblock %}
